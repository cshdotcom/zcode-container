# =============================================================
# ZCode 自托管 AI 工作容器 - 环境变量样例
# 使用：cp .env.example .env，然后按需修改
# 对外端口集中在本文件定义；改完执行 docker compose up -d 生效
# =============================================================

# ---------- 对外映射端口（可自行修改，一律避开常用端口号） ----------
# 绑定地址：默认 0.0.0.0（供内网/穿透访问）；仅走 SSH 隧道时可改 127.0.0.1
EXT_BIND_ADDR=0.0.0.0

# -> 容器内 3030：ZCode 网页端主入口
EXT_ZCODE_PORT=43030

# -> 容器内 7183：Selkies 远程桌面（desktop-on 开启后可访问；多人连同一端口）
EXT_SELKIES_PORT=47183

# -> 容器内 8080：空端口，纯备用（不跑任何预置服务，AI 可自主占用）
EXT_SPARE_PORT_1=40808

# -> 容器内 8090：空端口，纯备用（不跑任何预置服务，AI 可自主占用）
EXT_SPARE_PORT_2=40809

# ---------- ZCode ----------
# 网页访问令牌：留空 = 关闭令牌认证（默认，安全由穿透层负责）
# 设置后访问形式为 http://<host>:43030/?token=<你的令牌>
ZCODE_WEB_TOKEN=

# 凭据密钥（高级，一般无需设置）：
# ZCode 无头服务端需要凭据加密密钥；容器首次启动会在 /root/.zcode/v2/credential-secret
# 自动生成（0600）并持久化在 zcode-data 卷，重启不变。如需自备密钥，二选一：
# ZCODE_CREDENTIAL_SECRET_FILE=/root/.zcode/v2/credential-secret
# ZCODE_CREDENTIAL_SECRET=

# ---------- Selkies 远程桌面 ----------
# 空闲自动回收（秒）：无操作超过该时长自动 desktop-off；0 = 关闭
SELKIES_IDLE_TIMEOUT=900
# 传输模式：websockets（默认，TCP 友好，穿透/公网环境稳定）/ webrtc / 见 README
SELKIES_MODE=websockets
SELKIES_ENABLE_DUAL_MODE=true
# HTTPS 开关：默认 false（加密由用户穿透层负责）
SELKIES_ENABLE_HTTPS=false
# 会话桌面（openbox 轻量窗口管理器）
SELKIES_SESSION=openbox
# 可选 Basic Auth（默认关闭）
SELKIES_ENABLE_BASIC_AUTH=false
SELKIES_BASIC_AUTH_USER=
SELKIES_BASIC_AUTH_PASSWORD=
# 可选 TURN（仅 WebRTC 模式公网防火墙掐 UDP 时需要，见 README）
SELKIES_TURN_HOST=
SELKIES_TURN_PORT=
SELKIES_TURN_USERNAME=
SELKIES_TURN_PASSWORD=
SELKIES_TURN_SHARED_SECRET=

# ---------- 其他 ----------
TZ=Asia/Shanghai
