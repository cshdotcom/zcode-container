# =============================================================
# ZCode Cloudflare Tunnel + 内网双通道部署 - 环境变量（示例值，全部需替换）
# 按 README 的三步初始化生成真实值后：cp .env.example .env && docker compose up -d
# =============================================================

# ---------- 数据根目录（全部软件数据统一落在这：workspace/ data/ config/） ----------
ZCODE_BASE_DIR=/srv/zcode

# ---------- 访问凭据（自行生成，例如：openssl rand -hex 10 / head -c20 /dev/urandom|base64） ----------
ZCODE_WEB_TOKEN=REPLACE_WITH_RANDOM_TOKEN
DESKTOP_AUTH_USER=REPLACE_WITH_USERNAME
DESKTOP_AUTH_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# ---------- 内网/VPN 直连 ----------
EXT_BIND_ADDR=0.0.0.0
EXT_ZCODE_PORT=43030
EXT_SELKIES_PORT=47183
EXT_DESKTOP_HTTPS_PORT=47184
EXT_STATPREV_PORT=40881
EXT_DYNPREV1_PORT=40882
EXT_DYNPREV2_PORT=40883
EXT_DYNPREV_PORT=40808
EXT_SPARE_PORT=40809

SELKIES_IDLE_TIMEOUT=900
SELKIES_MODE=websockets
SELKIES_SESSION=openbox

TZ=Asia/Shanghai
